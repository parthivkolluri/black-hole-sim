
#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;

layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float mass[16];
};

const float SagA_rs = 1.269e10;
const float ESCAPE_R = 1e30;

float getStepSize(float r)
{
    float q = r / SagA_rs;

    if (q < 3.0)  return 1e7;
    if (q < 6.0)  return 3e7;
    if (q < 12.0) return 1e8;
    if (q < 25.0) return 3e8;

    return 1e9;
}

vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);
float hitRadius = 0.0;

struct Ray {
    float x, y, z;
    float r, theta, phi;
    float dr, dtheta, dphi;
    float E, L;
};

float safeSin(float theta)
{
    return max(abs(sin(theta)), 1e-5);
}

void updateCartesian(inout Ray ray)
{
    float st = sin(ray.theta);

    ray.x = ray.r * st * cos(ray.phi);
    ray.y = ray.r * st * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}

Ray initRay(vec3 pos, vec3 dir)
{
    Ray ray;

    ray.x = pos.x;
    ray.y = pos.y;
    ray.z = pos.z;

    ray.r = max(length(pos), SagA_rs * 1.001);
    ray.theta = acos(clamp(pos.z / ray.r, -1.0, 1.0));
    ray.phi = atan(pos.y, pos.x);

    float st = safeSin(ray.theta);
    float ct = cos(ray.theta);
    float sp = sin(ray.phi);
    float cp = cos(ray.phi);

    ray.dr =
        st * cp * dir.x +
        st * sp * dir.y +
        ct * dir.z;

    ray.dtheta =
        (ct * cp * dir.x +
         ct * sp * dir.y -
         st * dir.z) / ray.r;

    ray.dphi =
        (-sp * dir.x + cp * dir.y) /
        (ray.r * st);

    ray.L = ray.r * ray.r * st * ray.dphi;

    float f = max(1.0 - SagA_rs / ray.r, 1e-4);

    float dt_dL = sqrt(
        ray.dr * ray.dr / f +
        ray.r * ray.r *
        (ray.dtheta * ray.dtheta +
         st * st * ray.dphi * ray.dphi)
    );

    ray.E = f * dt_dL;

    return ray;
}

bool intercept(Ray ray, float rs)
{
    return ray.r <= rs;
}

bool interceptObject(Ray ray)
{
    vec3 P = vec3(ray.x, ray.y, ray.z);

    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;

        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            hitRadius = radius;
            return true;
        }
    }

    return false;
}

void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2)
{
    float r = max(ray.r, SagA_rs * 1.0001);
    float theta = ray.theta;

    float dr = ray.dr;
    float dtheta = ray.dtheta;
    float dphi = ray.dphi;

    float st = safeSin(theta);
    float ct = cos(theta);
    float f = max(1.0 - SagA_rs / r, 1e-4);

    float dt_dL = ray.E / f;

    d1 = vec3(dr, dtheta, dphi);

    d2.x =
        -(SagA_rs / (2.0 * r * r)) *
        f * dt_dL * dt_dL
        +
        (SagA_rs / (2.0 * r * r * f)) *
        dr * dr
        +
        r * (dtheta * dtheta + st * st * dphi * dphi);

    d2.y =
        -2.0 * dr * dtheta / r
        + st * ct * dphi * dphi;

    d2.z =
        -2.0 * dr * dphi / r
        - 2.0 * ct / st * dtheta * dphi;
}

Ray offsetRay(Ray base, vec3 k1a, vec3 k1b, float h)
{
    Ray result = base;

    result.r      += h * k1a.x;
    result.theta  += h * k1a.y;
    result.phi    += h * k1a.z;

    result.dr     += h * k1b.x;
    result.dtheta += h * k1b.y;
    result.dphi   += h * k1b.z;

    updateCartesian(result);

    return result;
}

void rk4Step(inout Ray ray, float dL)
{
    vec3 k1a, k1b;
    vec3 k2a, k2b;
    vec3 k3a, k3b;
    vec3 k4a, k4b;

    Ray base = ray;

    geodesicRHS(base, k1a, k1b);

    Ray temp = offsetRay(base, k1a, k1b, dL * 0.5);
    geodesicRHS(temp, k2a, k2b);

    temp = offsetRay(base, k2a, k2b, dL * 0.5);
    geodesicRHS(temp, k3a, k3b);

    temp = offsetRay(base, k3a, k3b, dL);
    geodesicRHS(temp, k4a, k4b);

    ray.r += dL / 6.0 *
        (k1a.x + 2.0 * k2a.x + 2.0 * k3a.x + k4a.x);

    ray.theta += dL / 6.0 *
        (k1a.y + 2.0 * k2a.y + 2.0 * k3a.y + k4a.y);

    ray.phi += dL / 6.0 *
        (k1a.z + 2.0 * k2a.z + 2.0 * k3a.z + k4a.z);

    ray.dr += dL / 6.0 *
        (k1b.x + 2.0 * k2b.x + 2.0 * k3b.x + k4b.x);

    ray.dtheta += dL / 6.0 *
        (k1b.y + 2.0 * k2b.y + 2.0 * k3b.y + k4b.y);

    ray.dphi += dL / 6.0 *
        (k1b.z + 2.0 * k2b.z + 2.0 * k3b.z + k4b.z);

    updateCartesian(ray);
}

bool crossesEquatorialPlane(
    vec3 oldPos,
    vec3 newPos,
    out vec3 hitPos
)
{
    if (oldPos.y * newPos.y >= 0.0)
        return false;

    float denom = oldPos.y - newPos.y;

    if (abs(denom) < 1e-6)
        return false;

    float t = oldPos.y / denom;

    if (t < 0.0 || t > 1.0)
        return false;

    hitPos = mix(oldPos, newPos, t);

    float r = length(hitPos.xz);

    return r >= disk_r1 && r <= disk_r2;
}

void main()
{
    const int WIDTH = 200;
    const int HEIGHT = 150;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

    if (pix.x >= WIDTH || pix.y >= HEIGHT)
        return;

    float u =
        (2.0 * (float(pix.x) + 0.5) / float(WIDTH) - 1.0)
        * cam.aspect * cam.tanHalfFov;

    float v =
        (1.0 - 2.0 * (float(pix.y) + 0.5) / float(HEIGHT))
        * cam.tanHalfFov;

    vec3 dir = normalize(
        u * cam.camRight -
        v * cam.camUp +
        cam.camForward
    );

    Ray ray = initRay(cam.camPos, dir);

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    vec3 diskHitPos = vec3(0.0);

    bool hitBlackHole = false;
    bool hitDisk = false;
    bool hitObject = false;

    int steps = cam.moving ? 20000 : 20001;

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, SagA_rs)) {
            hitBlackHole = true;
            break;
        }

        float stepSize = getStepSize(ray.r);
        rk4Step(ray, stepSize);

        if (intercept(ray, SagA_rs)) {
            hitBlackHole = true;
            break;
        }

        vec3 newPos = vec3(ray.x, ray.y, ray.z);

        if (crossesEquatorialPlane(prevPos, newPos, diskHitPos)) {
            hitDisk = true;
            break;
        }

        if (interceptObject(ray)) {
            hitObject = true;
            break;
        }

        prevPos = newPos;

        if (ray.r > ESCAPE_R)
            break;
    }

    if (hitDisk) {
        float r = clamp(
            length(diskHitPos.xz) / max(disk_r2, 1.0),
            0.0,
            1.0
        );

        // Warm orange -> gold -> hot cream
        vec3 innerColor  = vec3(1.0, 0.20, 0.035);
        vec3 middleColor = vec3(1.0, 0.48, 0.10);
        vec3 outerColor  = vec3(1.0, 0.82, 0.42);

        vec3 diskColor;

        if (r < 0.5) {
            diskColor = mix(
                innerColor,
                middleColor,
                r * 2.0
            );
        } else {
            diskColor = mix(
                middleColor,
                outerColor,
                (r - 0.5) * 2.0
            );
        }

        // Narrow, bright highlight band
        float band = exp(
            -pow((r - 0.78) / 0.10, 2.0)
        );

        diskColor = mix(
            diskColor,
            vec3(1.0, 0.94, 0.72),
            band * 0.65
        );

        color = vec4(diskColor, 1.0);

    } else if (hitBlackHole) {
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (hitObject) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(cam.camPos - P);

        float ambient = 0.1;
        float diff = max(dot(N, V), 0.0);
        float intensity = ambient + (1.0 - ambient) * diff;

        vec3 shaded = objectColor.rgb * intensity;
        color = vec4(shaded, objectColor.a);

    } else {
        color = vec4(0.0);
    }

    imageStore(outImage, pix, color);
}
